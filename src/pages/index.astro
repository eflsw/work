---
import { projects } from '@/data/projects'
import { experiences } from '@/data/experiences'
import { formation } from '@/data/formation'
import { stack } from '@/data/stack'
import { awards } from '@/data/awards'
import Layout from '@/layouts/Layout.astro'
import Header from '@/components/layout/Header'
import Contact from '@/components/Contact'
---

<Layout>
    <Header client:load />

    <main class="mt-14 space-y-13">
        <article class="space-y-2">
            <p>
                Front end developer with +4 years of experience in web development. With the intention of exploring its potential to express concepts, and solve problems.
            </p>
            <p>I'm 19 years old, and I started learning to code when I was 15. Originally from Mexico; I speak Spanish, and English ––B2 level.</p>
            <p>
                I've a particular interest in microinteractions, performance, typography, minimalism, and meaningful design. I appreciate proper spelling, and learning
                ––in which I'm particularly versed.
            </p>
        </article>
        <div><Contact client:load /></div>
        <section>
            <h2 class="text-muted-foreground">Some Projects</h2>
            <div class="space-y-4">
                {
                    projects.map((project) => {
                        const Card = project.url ? 'a' : 'div'

                        return (
                            <Card
                                href={project.url}
                                target={project.url ? '_blank' : undefined}
                                rel={project.url ? 'noopener noreferrer' : undefined}
                                class="group relative block h-fit w-full overflow-hidden rounded-xl border p-2 transition"
                            >
                                {project.image && <img src={project.image} alt={project.name} class="h-auto w-full rounded-lg object-cover" />}
                                <div class="bg-background absolute top-0 left-0 flex size-full flex-col items-center justify-center opacity-0 transition duration-200 group-hover:opacity-100">
                                    <hgroup>{project.name}</hgroup>
                                    <span class="text-muted-foreground font-mono text-xs tracking-tighter uppercase">{project.type}</span>
                                </div>
                            </Card>
                        )
                    })
                }
            </div>
        </section>
        <section>
            <h2 class="text-muted-foreground">Experience</h2>
            {
                experiences.map((item) => (
                    <div class="space-y-1">
                        <h2>
                            <strong>{item.title}</strong> –– {item.company}
                        </h2>
                        <h3 class="text-muted-foreground text-sm">{item.date}</h3>
                        <p>{item.description}</p>
                        <div class="mt-2! flex items-center gap-1">
                            {item.features.map((tag) => (
                                <span class="bg-muted/70 size-fit rounded-sm px-1.5 py-0.5 text-xs tracking-normal select-none">{tag}</span>
                            ))}
                        </div>
                    </div>
                ))
            }
        </section>
        <section>
            <h2 class="text-muted-foreground">Formation</h2>
            {
                formation.map((item) => (
                    <div class="space-y-1">
                        <h2 class="font-medium">{item.title}</h2>
                        <h3 class="text-muted-foreground text-sm">
                            {item.institution} –– {item.date}
                        </h3>
                        <p>{item.description}</p>
                    </div>
                ))
            }
        </section>
        <section>
            <h2 class="text-muted-foreground">Skills</h2>
            <table class="w-full table-auto">
                <tbody>
                    {
                        stack.map((item) => (
                            <tr class="*:py-1.5">
                                <td class="flex pr-8">{item.category}</td>
                                <td class="text-muted-foreground text-balance">
                                    {item.skills.map((skill, index) => (
                                        <span>{`${skill}${index < item.skills.length - 1 ? ', ' : ''}`}</span>
                                    ))}
                                </td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </section>
        <section>
            <h2 class="text-muted-foreground">Awards</h2>
            <ul class="space-y-1.5">
                {
                    awards.map((award) => (
                        <li>
                            {award.title}
                            <span class="text-muted-foreground"> –– {award.info}</span>
                        </li>
                    ))
                }
            </ul>
        </section>
    </main>
</Layout>
